# JobHunter Pro Environment Variables

# Application
NODE_ENV=production
PORT=3000
TZ=Asia/Shanghai

# Boss直聘登录凭证
BOSS_PHONE=your_phone_number_here
BOSS_PASSWORD=your_password_here

# Security
SESSION_SECRET=change_this_to_a_random_string_in_production
CORS_ORIGIN=https://your-domain.com

# Performance
THROTTLE=2000
MAX_RETRIES=3
REQUEST_TIMEOUT=30000

# Logging
LOG_LEVEL=info
ENABLE_FILE_LOGGING=true
LOG_DIR=/app/logs

# Browser (Puppeteer)
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
HEADLESS=true

# Data Storage
DATA_DIR=/app/data
SESSIONS_DIR=/app/sessions
COOKIES_DIR=/app/cookies

# Rate Limiting
MAX_DAILY_APPLICATIONS=100
APPLY_INTERVAL=30000

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
